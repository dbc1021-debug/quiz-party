rules_version = '2';
// 可愛搶答派對 — Firestore 安全規則
// ⚠️ 把下面的 your.name@gmail.com 換成你的 Google 帳號（可放多個，用逗號隔開）
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['your.name@gmail.com'];
    }
    function signedIn() { return request.auth != null; }

    // 題庫、風格、測驗組合、歷史紀錄：只有老師能讀寫
    match /imports/{id}  { allow read, write: if isAdmin(); }
    match /themes/{id}   { allow read, write: if isAdmin(); }
    match /quizzes/{id}  { allow read, write: if isAdmin(); }
    match /history/{id}  { allow read, write: if isAdmin(); }

    match /games/{pin} {
      // 遊戲狀態大家都看得到（裡面不含還沒公布的答案）
      allow read: if true;
      allow write: if isAdmin();

      match /theme/{d}   { allow read: if true; allow write: if isAdmin(); }
      // 含正確答案與分數，只有老師能看
      match /private/{d} { allow read, write: if isAdmin(); }

      // 名稱佔位：同一個名稱只能被一個人建立
      match /names/{name} {
        allow read, delete: if isAdmin();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && name.size() <= 40
          && get(/databases/$(database)/documents/games/$(pin)).data.state != 'final';
      }

      // 玩家：只能建立自己的資料，名稱必須是自己佔到的
      match /players/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow delete: if isAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 12
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/games/$(pin)/names/$(request.resource.data.name)).data.uid == request.auth.uid;
      }

      // 作答：每題每人只能送一次、不能修改；送出時間由伺服器蓋章
      match /answers/{aid} {
        allow read, delete: if isAdmin();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.index is int
          && aid == string(request.resource.data.index) + '_' + request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['uid', 'index', 'choices', 'text', 'at'])
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 200))
          && (!('choices' in request.resource.data) || (request.resource.data.choices is list && request.resource.data.choices.size() <= 6));
      }
    }
  }
}
